NODE_ENV=development
API_PORT=4000
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

POSTGRES_USER=nutrilog
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
POSTGRES_DB=nutrilog
DATABASE_URL=postgresql://nutrilog:replace-with-a-long-random-local-password@localhost:5432/nutrilog?schema=public

REDIS_PASSWORD=replace-with-another-long-random-local-password
REDIS_URL=redis://:replace-with-another-long-random-local-password@localhost:6379
